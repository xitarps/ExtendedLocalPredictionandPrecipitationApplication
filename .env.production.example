# Production env for Compose / the Rails container.
# Copy to .env.production (already gitignored). Do not overwrite the development .env.
#
# Rails reads DB_USERNAME, DB_PASSWORD, DB_HOST and DB_PORT.
# It does not read DB_NAME. That is only for the Postgres image (POSTGRES_DB)
# and must match the database name in config/database.yml.
#
# DB_PORT is the port Postgres listens on inside the container (always 5432).
# DB_HOST_PORT is the host publish port for DBeaver only.

RAILS_ENV=production
# Paste the value from config/master.key. Do not invent this.
RAILS_MASTER_KEY=
RAILS_LOG_LEVEL=info
TZ=America/Fortaleza

# App role. Compose creates this as POSTGRES_USER. database.yml uses the same vars.
DB_USERNAME=elppa
DB_PASSWORD=change-me
# Fallback only if DB_PASSWORD is unset. Keep it identical.
ELPPA_DATABASE_PASSWORD=change-me
DB_PORT=5432
DB_HOST=db
DB_NAME=elppa_production

# Host port. Not used by Rails. Avoid publishing this on a public interface.
DB_HOST_PORT=5432

# Sidekiq (worker/entrypoint.sh) reads REDIS_URL, defaulting to localhost if unset.
# The Compose redis service has no password, so this URL must not include one.
REDIS_URL=redis://redis:6379/0
SIDEKIQ_CONCURRENCY=5
SIDEKIQ_WEB_USERNAME=admin
SIDEKIQ_WEB_PASSWORD=change-me
