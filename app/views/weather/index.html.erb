<h1>Weather Forecast Results</h1>

<% if @weather_stream.present? %>
  <div data-controller="weather-loader"
       data-weather-loader-url-value="<%= weather_enqueue_path %>"
       data-weather-loader-stream-name-value="<%= @weather_stream %>"
       data-weather-loader-zip-code-value="<%= params[:zip_code] %>"
       data-weather-loader-country-code-value="<%= params[:country_code] %>">
    <%= turbo_stream_from @weather_stream %>
    <div id="weather_results">
      <p>loading...</p>
    </div>
  </div>
<% end %>
